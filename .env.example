# ==== Base de données ====
# SQLite (par défaut, aucune installation nécessaire) :
DATABASE_URL="file:./dev.db"
# PostgreSQL (production), exemple :
# DATABASE_URL="postgresql://user:password@localhost:5432/afg?schema=public"

# ==== Serveur ====
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
# En production, mettez l'URL réelle de votre site, ex :
# CLIENT_ORIGIN="https://auxfoliesgourmandes.tn"

# ==== Authentification gérant ====
JWT_SECRET="change-moi-en-une-longue-chaine-aleatoire"
JWT_EXPIRES_IN="12h"

# ==== Identifiants gérant créés automatiquement par le script de seed ====
# (à changer immédiatement après la première connexion)
SEED_ADMIN_USERNAME="gerant"
SEED_ADMIN_PASSWORD="kram2026"

# ==== Créneaux de livraison ====
# Nombre maximum de commandes actives acceptées sur un même créneau,
# le même jour, avant qu'il soit affiché comme "complet" côté client.
MAX_ORDERS_PER_SLOT=8

# ==== Géolocalisation (Nominatim / OpenStreetMap — gratuit, pas de clé) ====
# Requis par la politique d'usage de Nominatim : un moyen de vous contacter
# s'ils remarquent un usage abusif. Mettez une vraie adresse email.
NOMINATIM_CONTACT_EMAIL="Letraiteurmed@gmail.com"

# ==== SMS (Twilio — optionnel, nécessite un compte payant) ====
# Laissez vide pour désactiver l'envoi de SMS sans casser le site.
# TWILIO_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

